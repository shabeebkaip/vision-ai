# Copy to .env (never committed) and fill in. Every variable has the VISION_ prefix.
# Generate the two cloud keys with:  uv run vision-cloud gen-keys

# ----------------------------------------------------------------- edge (vision_edge.settings)
# VISION_DETECTOR=rfdetr-nano
# VISION_TELEGRAM_BOT_TOKEN=
# VISION_TELEGRAM_CHAT_ID=

# ----------------------------------------------------------------- cloud (vision_cloud.settings)
VISION_CLOUD_ENVIRONMENT=dev
# The API must connect as a role without superuser/BYPASSRLS (row-level security, CLD-02).
VISION_CLOUD_DATABASE_URL=postgresql+psycopg://vision_app:vision-app-dev@localhost:5432/vision
VISION_CLOUD_JWT_SECRET=
VISION_CLOUD_FIELD_ENCRYPTION_KEY=
# VISION_CLOUD_ACCESS_TOKEN_TTL_S=900
# VISION_CLOUD_REFRESH_TOKEN_TTL_S=2592000

# Object storage: "s3" (SeaweedFS locally, provider S3 in staging/production) or "local" (files).
VISION_CLOUD_STORAGE_BACKEND=s3
VISION_CLOUD_STORAGE_BUCKET=vision-media
VISION_CLOUD_STORAGE_ENDPOINT_URL=http://localhost:9000
# VISION_CLOUD_STORAGE_PUBLIC_ENDPOINT_URL=
VISION_CLOUD_STORAGE_ACCESS_KEY=vision-dev
VISION_CLOUD_STORAGE_SECRET_KEY=vision-dev-secret
# VISION_CLOUD_STORAGE_SSE=AES256
# VISION_CLOUD_STORAGE_LOCAL_DIR=var/cloud-storage

VISION_CLOUD_PUBLIC_BASE_URL=http://localhost:8000
VISION_CLOUD_CORS_ORIGINS=["http://localhost:5173"]
VISION_CLOUD_LOG_JSON=false

# Only for local docker compose (deploy/docker-compose.dev.yml)
# VISION_DEV_DB_OWNER_PASSWORD=vision-owner-dev
# VISION_DEV_DB_APP_PASSWORD=vision-app-dev
# Fake cameras: folder of clips (relative to deploy/) and the file each camera loops. Point these at
# real clips (never in Git) and change the zones and rules in deploy/dev/site.yaml to match.
# CLIPS_DIR=../test-videos/synthetic
# CAM1_CLIP=syn-queue-001.mp4
# CAM2_CLIP=syn-unattended-001.mp4
# CAM3_CLIP=syn-entrance-001.mp4
# CAM4_CLIP=syn-crowd-001.mp4
# Edge image: rfdetr builds RF-DETR + PyTorch in (needed for the rfdetr-* detectors); empty = ONNX only
# EDGE_EXTRAS=rfdetr
# VISION_DETECTOR_THRESHOLD=0.35
# Dashboard: empty = built-in demo data; http://localhost:8000/api/v1 = the API
# VITE_API_BASE_URL=

# Only for one-off CLI commands (otherwise you are prompted)
# VISION_CLOUD_SEED_PASSWORD=
# VISION_CLOUD_ADMIN_PASSWORD=

# Only for the PostgreSQL test run (a throwaway database: the tests drop its schema)
# VISION_CLOUD_TEST_POSTGRES_URL=postgresql+psycopg://postgres:postgres@localhost:5432/vision_test
