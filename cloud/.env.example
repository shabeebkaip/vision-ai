# Code-Ox Vision cloud settings. Copy to cloud/.env (never commit it) or set in the environment.
# A missing required setting stops the service at start-up with a readable message.

# --- required ------------------------------------------------------------------------------
# The role must NOT be a superuser or have BYPASSRLS: row-level security is the second lock.
VISION_DATABASE_URL=postgresql+psycopg://vision:change-me@localhost:5432/vision
# At least 32 characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
VISION_JWT_SECRET=
# Fernet key for stream URLs and 2FA secrets: uv run vision-cloud gen-key
VISION_ENCRYPTION_KEY=

# --- object storage (MinIO in dev) -----------------------------------------------------------
VISION_STORAGE_BACKEND=s3
VISION_S3_ENDPOINT_URL=http://localhost:9000
# Host the edge boxes use to reach storage, if different from the API's view
VISION_S3_PUBLIC_ENDPOINT_URL=
VISION_S3_REGION=us-east-1
VISION_S3_BUCKET=vision-media
VISION_S3_ACCESS_KEY=
VISION_S3_SECRET_KEY=
VISION_S3_SERVER_SIDE_ENCRYPTION=AES256

# --- rate limits (Redis shares the buckets across API workers) -------------------------------
VISION_REDIS_URL=redis://localhost:6379/0
VISION_DEVICE_RATE_LIMIT_PER_MIN=600
VISION_DEVICE_RATE_LIMIT_BURST=120
VISION_MAX_BATCH_EVENTS=500

# --- mail ------------------------------------------------------------------------------------
# console (dev only: prints one-time links to the log) | smtp | memory (tests)
VISION_MAIL_BACKEND=console
VISION_MAIL_FROM=Code-Ox Vision <no-reply@vision.code-ox.com>
VISION_SMTP_HOST=
VISION_SMTP_PORT=587
VISION_SMTP_USERNAME=
VISION_SMTP_PASSWORD=
VISION_PUBLIC_WEB_URL=http://localhost:5173

# --- http ------------------------------------------------------------------------------------
VISION_CORS_ORIGINS=["http://localhost:5173"]
VISION_LOG_JSON=false
# dev | test | staging | production (staging/production refuse a superuser DB role)
VISION_ENVIRONMENT=dev
