# Copy to deploy/.env (never committed). Values here are for a laptop only.
POSTGRES_DB=vision
POSTGRES_USER=vision
POSTGRES_PASSWORD=change-me-dev-only
S3_ACCESS_KEY=vision
S3_SECRET_KEY=change-me-dev-only

# Host ports (bound to 127.0.0.1)
POSTGRES_PORT=5432
REDIS_PORT=6379
S3_PORT=8333
RTSP_PORT=8554

# Fake cameras: folder of clips and the file each camera loops.
# CLIPS_DIR is relative to deploy/. Point it at real clips (e.g. ../test-videos/clips) and
# update deploy/dev/site.yaml zones and rules to match.
CLIPS_DIR=../test-videos/synthetic
CAM1_CLIP=syn-queue-001.mp4
CAM2_CLIP=syn-unattended-001.mp4
CAM3_CLIP=syn-entrance-001.mp4
CAM4_CLIP=syn-crowd-001.mp4

# Edge: EDGE_EXTRAS=rfdetr builds RF-DETR + PyTorch into the image (needed for rfdetr-* detectors).
EDGE_EXTRAS=rfdetr
VISION_DETECTOR=rfdetr-nano
VISION_DETECTOR_THRESHOLD=0.35
