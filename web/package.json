{
  "name": "codeox-vision-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "i18n:check": "node scripts/check-i18n.mjs",
    "gen:types": "json2ts -i src/api/schema.json -o src/api/types.ts --unreachableDefinitions --no-additionalProperties --ignoreMinAndMaxItems --bannerComment \"/* Generated from src/api/schema.json by json-schema-to-typescript (npm run gen:types). Do not edit. */\" && prettier --write src/api/types.ts",
    "screenshots": "node scripts/screenshots.cjs",
    "licences": "node scripts/check-licences.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.2",
    "i18next": "^26.7.1",
    "konva": "^10.9.1",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.11",
    "react-konva": "^19.3.2",
    "react-router": "^8.5.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
